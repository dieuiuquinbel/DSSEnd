# ── Python runtime / test output ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Local configuration and secrets (không lưu API key/mật khẩu)
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ── Node / Frontend ──
frontend/node_modules/
frontend/dist/
frontend/.pytest_cache/
frontend/.vite/

# ── OS / Editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# ── Temporary files ──
*.tmp
*.bak
~$*

